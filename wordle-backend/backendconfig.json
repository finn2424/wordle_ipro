{
  "$schema": "https://raw.githubusercontent.com/Kull-AG/kull-generic-backend/master/backendconfig.schema.json",
  "Entities": {
    "User/GetOrCreate": {
      "POST": {
        "SP": "dbo.spUser_GetOrCreate",
        "OperationId": "GetOrCreateUser"
      }
    },
    "Game/Start": {
      "POST": {
        "SP": "dbo.spGame_Start",
        "OperationId": "StartGame"
      }
    },
    "Game/SubmitGuess": {
      "POST": {
        "SP": "dbo.spGame_SubmitGuess",
        "OperationId": "SubmitGuess"
      }
    },
    "Stats": {
      "GET": {
        "SP": "dbo.spStats_Get",
        "OperationId": "GetStats"
      }
    },
    "Stats/Advanced": {
      "GET": {
        "SP": "dbo.spStats_GetAdvanced",
        "OperationId": "GetAdvancedStats"
      }
    }
  }
}